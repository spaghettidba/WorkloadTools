                      },
                      "spec": {
                        "queryText": "SELECT\n   ((CAST(strftime('%s', I.end_time) AS INTEGER) - 0) / (60000/1000)) * (60000/1000) AS time\n  ,SUM(WD.sum_duration_us) AS 'test4'\nFROM WorkloadDetails WD\n    JOIN Intervals I ON WD.interval_id = I.interval_id\n  WHERE WD.sql_hash IN (\"-4337140546958801659\")\n    AND time BETWEEN 1778140800 AND 1778162400\nGROUP BY time\nORDER BY 1",
                        "queryType": "time series",
                        "rawQueryText": "SELECT\n   ((CAST(strftime('%s', I.end_time) AS INTEGER) - ${BenchmarkTimeDiff}) / ($__interval_ms/1000)) * ($__interval_ms/1000) AS time\n  ,SUM(WD.sum_duration_us) AS '${Benchmark:text}'\nFROM WorkloadDetails WD\n    JOIN Intervals I ON WD.interval_id = I.interval_id\n  WHERE WD.sql_hash IN (${SqlHash:doublequote})\n    AND time BETWEEN ${__from:date:seconds} AND ${__to:date:seconds}\nGROUP BY time\nORDER BY 1",
                        "timeColumns": [
